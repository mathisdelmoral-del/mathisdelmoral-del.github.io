
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mes recettes préférées</title>

  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f5f5f5;
      color: #222;
    }

    header {
      background: #2e7d32;
      color: white;
      text-align: center;
      padding: 25px;
    }

    main {
      max-width: 900px;
      margin: 30px auto;
      padding: 20px;
    }

    .recipe {
      background: white;
      padding: 20px;
      margin-bottom: 20px;
      border-radius: 12px;
      box-shadow: 0 2px 8px #0001;
    }

    button {
      background: #2e7d32;
      color: white;
      border: 0;
      border-radius: 8px;
      padding: 12px 18px;
      cursor: pointer;
      font-size: 16px;
    }

    button:hover {
      background: #1b5e20;
    }

    #hackerScreen {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: black;
      overflow: hidden;
      padding: 20px;
      box-sizing: border-box;
      font-family: monospace;
    }

    #hackerLayout {
      display: flex;
      gap: 20px;
      height: 100%;
    }

    #hackerText {
      flex: 1;
      color: #00ff00;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      font-size: 14px;
      line-height: 1.3;
      overflow: hidden;
    }

    #hackerMessage {
      color: red;
      font-size: 24px;
      font-weight: bold;
      width: 260px;
      padding-top: 20px;
    }

    @media (max-width: 600px) {
      #hackerLayout {
        flex-direction: column;
      }

      #hackerMessage {
        width: auto;
        font-size: 20px;
      }
    }
  </style>
</head>

<body>
  <header>
    <h1>🍳 Mes recettes préférées</h1>
    <p>Des idées simples et délicieuses à cuisiner</p>
  </header>

  <main id="mainContent">
    <section class="recipe">
      <h2>🍝 Pâtes à la tomate</h2>
      <p>Des pâtes avec une sauce tomate maison.</p>
      <h3>Ingrédients</h3>
      <ul>
        <li>200 g de pâtes</li>
        <li>Une sauce tomate</li>
        <li>Un peu de fromage râpé</li>
      </ul>
    </section>

    <section class="recipe">
      <h2>🥞 Crêpes</h2>
      <p>De délicieuses crêpes à partager.</p>
      <h3>Ingrédients</h3>
      <ul>
        <li>250 g de farine</li>
        <li>3 œufs</li>
        <li>500 ml de lait</li>
      </ul>
    </section>

    <button id="moreButton">Voir plus de recettes</button>
  </main>

  <div id="hackerScreen">
    <div id="hackerLayout">
      <div id="hackerText"></div>
      <div id="hackerMessage">VOUS VOUS ÊTES LES HACKERS</div>
    </div>
  </div>

  <script>
    const moreButton = document.getElementById("moreButton");
    const mainContent = document.getElementById("mainContent");
    const hackerScreen = document.getElementById("hackerScreen");
    const hackerText = document.getElementById("hackerText");

    let intervalId;

    moreButton.addEventListener("click", () => {
      mainContent.style.display = "none";
      hackerScreen.style.display = "block";

      intervalId = setInterval(() => {
        let line = "";

        for (let i = 0; i < 100; i++) {
          line += Math.random() > 0.5 ? "1" : "0";
        }

        hackerText.textContent += line + "\n";

        const lines = hackerText.textContent.split("\n");
        if (lines.length > 100) {
          hackerText.textContent = lines.slice(-100).join("\n");
        }
      }, 100);
    });
  </script>
</body>
</html>
